  "description": "Lightweight MMX wallet for the browser — keys never leave your device",
  "type": "module",
  "scripts": {
    "test": "for t in test/*.mjs; do node \"$t\"; done",
    "test:crypto": "node test/test-crypto.mjs",
    "test:regression": "node test/test-regression.mjs",
    "test:fuzz": "node test/test-fuzz.mjs",
    "test:integration": "node test/test-integration.mjs",
    "test:security": "node test/test-security.mjs",
    "test:dapp": "node test/test-dapp.mjs",
    "test:golden": "node test/test-golden.mjs"
  },
  "dependencies": {
    "@noble/secp256k1": "^3.1.0",
