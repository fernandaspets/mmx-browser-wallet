{
  "manifest_version": 3,
  "name": "MMX Wallet",
  "version": "1.0.0",
  "description": "Lightweight MMX wallet for the browser — keys never leave your device",
  "author": "FernandasPets",
  "homepage_url": "https://github.com/fernandaspets/mmx-browser-wallet",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://rpc.mmx.network/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MMX Wallet",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["wordlist.txt", "inject.js", "wallet.html", "wallet-app.js", "wallet-store.js", "mmx-node-api.js", "mmx-tx.js", "theme.css", "lib/bech32-esm.js", "lib/buffer-esm.js", "node_modules/@noble/secp256k1/*", "node_modules/@noble/hashes/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wallet@mmx.network"
    }
  }
}
